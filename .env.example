APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
# Local SQLite for development. Render supplies PostgreSQL DATABASE_URL.
DATABASE_URL=sqlite:///farm_brain.db
ADMIN_EMAIL=
COOKIE_SECURE=false
FLASK_DEBUG=false

# Email OTP and password reset. For Gmail, use smtp.gmail.com:587, your Gmail
# address and a Google App Password generated after enabling 2-Step Verification.
# Never put a normal Gmail account password here. Use provider credentials and
# store these values as Render environment secrets, not in Git.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20
OTP_DEV_MODE=true
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60

# Upload storage. Local development defaults to instance/uploads.
# Optional persistent public photo storage. If configured, community/profile
# photos go to Cloudinary. Private message attachments remain on the server disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional official Open Government Data / AGMARKNET API connector.
OGD_API_KEY=
OGD_MANDI_RESOURCE_ID=
OGD_API_BASE_URL=https://data.gov.in/api/datastore/resource.json
SOIL_HEALTH_API_TOKEN=
