APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
# Local SQLite for development. Online deployment uses an external Neon PostgreSQL URL.
DATABASE_URL=sqlite:///farm_brain.db
ADMIN_EMAIL=
COOKIE_SECURE=false
FLASK_DEBUG=false

# Brevo Free SMTP for online email OTP (Render Free blocks SMTP ports 25/465/587;
# Brevo port 2525 is configured in render.yaml). Keep real credentials in Render's
# environment settings only. Never commit an actual .env file or SMTP key.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20
OTP_DEV_MODE=true
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60

# Public photo storage is local in development. On Render Free, all uploaded files
# are temporary and may disappear after a restart, sleep or redeploy.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional official Open Government Data / AGMARKNET API connector.
OGD_API_KEY=
OGD_MANDI_RESOURCE_ID=
OGD_API_BASE_URL=https://data.gov.in/api/datastore/resource.json
SOIL_HEALTH_API_TOKEN=
